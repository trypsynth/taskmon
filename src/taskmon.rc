#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDR_ACCEL ACCELERATORS
BEGIN
	VK_F5, ID_VIEW_REFRESH, VIRTKEY
	0xBC, ID_VIEW_SETTINGS, VIRTKEY, CONTROL
	VK_DELETE, ID_CTX_END_TASK, VIRTKEY
	"N", ID_FILE_NEW_TASK, VIRTKEY, CONTROL
	"T", ID_VIEW_TREE_MODE, VIRTKEY, CONTROL
	"Q", ID_FILE_EXIT, VIRTKEY, CONTROL
END

IDD_RUN DIALOGEX 0, 0, 240, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Task"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "Type the name of a program, folder, or document, and Taskmon will open it for you.", -1, 7, 7, 226, 16
	EDITTEXT IDC_RUN_EDIT, 7, 28, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "OK", IDOK, 72, 48, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 126, 48, 50, 14
	PUSHBUTTON "&Browse...", IDC_RUN_BROWSE, 183, 48, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 200, 204
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	CONTROL "", IDC_SETTINGS_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 186, 176
	DEFPUSHBUTTON "OK", IDOK, 86, 186, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 143, 186, 50, 14
END

IDD_TAB_GENERAL DIALOGEX 0, 0, 178, 158
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "&Auto-refresh", -1, 4, 9, 48, 8
	COMBOBOX IDC_REFRESH_COMBO, 56, 7, 116, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	AUTOCHECKBOX "&Disable end task confirmation (not recommended)", IDC_SKIP_CONFIRM, 4, 30, 170, 18, BS_MULTILINE | WS_TABSTOP
	AUTOCHECKBOX "Start &minimized to tray", IDC_START_MINIMIZED, 4, 52, 170, 10, WS_TABSTOP
END

IDD_TAB_COLUMNS DIALOGEX 0, 0, 178, 158
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "&Columns", -1, 4, 4, 170, 8
	CONTROL "", IDC_COL_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 16, 170, 118
	PUSHBUTTON "Move &up", IDC_COL_UP, 4, 140, 60, 14
	PUSHBUTTON "Move dow&n", IDC_COL_DOWN, 68, 140, 60, 14
END
