#include "resource.h"
#include <windows.h>
#include <commctrl.h>

IDR_ACCEL ACCELERATORS
BEGIN
	VK_F5, ID_VIEW_REFRESH, VIRTKEY
	0xBC, ID_VIEW_SETTINGS, VIRTKEY, CONTROL
	VK_DELETE, ID_CTX_END_TASK, VIRTKEY
	"N", ID_FILE_NEW_TASK, VIRTKEY, CONTROL
	"T", ID_VIEW_TREE_MODE, VIRTKEY, CONTROL
	"Q", ID_FILE_EXIT, VIRTKEY, CONTROL
	VK_TAB, ID_VIEW_NEXT_TAB, VIRTKEY, CONTROL
	VK_TAB, ID_VIEW_PREV_TAB, VIRTKEY, CONTROL, SHIFT
	"F", ID_EDIT_FIND, VIRTKEY, CONTROL
	VK_F3, ID_EDIT_FIND_NEXT, VIRTKEY
	VK_F3, ID_EDIT_FIND_PREV, VIRTKEY, SHIFT
END

IDD_RUN DIALOGEX 0, 0, 240, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create New Task"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "Type the name of a program, folder, or document, and Taskmon will open it for you.", -1, 7, 7, 226, 16
	EDITTEXT IDC_RUN_EDIT, 7, 28, 226, 14, ES_AUTOHSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "OK", IDOK, 72, 48, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 126, 48, 50, 14
	PUSHBUTTON "&Browse...", IDC_RUN_BROWSE, 183, 48, 50, 14
END

IDD_FIND DIALOGEX 0, 0, 240, 48
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "Fi&nd what:", -1, 7, 10, 44, 8
	EDITTEXT IDC_FIND_EDIT, 54, 7, 179, 14, ES_AUTOHSCROLL | WS_TABSTOP
	DEFPUSHBUTTON "Find", IDOK, 126, 28, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 183, 28, 50, 14
END

IDD_SETTINGS DIALOGEX 0, 0, 200, 286
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Settings"
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	CONTROL "", IDC_SETTINGS_TAB, "SysTabControl32", WS_TABSTOP, 7, 7, 186, 258
	DEFPUSHBUTTON "OK", IDOK, 86, 268, 50, 14
	PUSHBUTTON "Cancel", IDCANCEL, 143, 268, 50, 14
END

IDD_TAB_GENERAL DIALOGEX 0, 0, 178, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "&Auto-refresh", -1, 4, 9, 48, 8
	COMBOBOX IDC_REFRESH_COMBO, 56, 7, 116, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
	AUTOCHECKBOX "&Disable end task confirmation (not recommended)", IDC_SKIP_CONFIRM, 4, 30, 170, 18, BS_MULTILINE | WS_TABSTOP
	AUTOCHECKBOX "Start &minimized to tray", IDC_START_MINIMIZED, 4, 52, 170, 10, WS_TABSTOP
END

IDD_TAB_COLUMNS DIALOGEX 0, 0, 178, 240
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
EXSTYLE WS_EX_CONTROLPARENT
FONT 8, "MS Shell Dlg", 0, 0, 0x0
BEGIN
	LTEXT "&Process columns", -1, 4, 4, 170, 8
	CONTROL "", IDC_COL_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 16, 170, 86
	PUSHBUTTON "Move &up", IDC_COL_UP, 4, 106, 60, 14
	PUSHBUTTON "Move dow&n", IDC_COL_DOWN, 68, 106, 60, 14
	LTEXT "&Service columns", -1, 4, 128, 170, 8
	CONTROL "", IDC_SVC_COL_LIST, "SysListView32", LVS_REPORT | LVS_NOCOLUMNHEADER | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_BORDER | WS_TABSTOP, 4, 140, 170, 72
	PUSHBUTTON "Move u&p", IDC_SVC_COL_UP, 4, 216, 60, 14
	PUSHBUTTON "Move &down", IDC_SVC_COL_DOWN, 68, 216, 60, 14
END
